@model AdminSportFormViewModel
@{
    ViewData["Title"] = "New sport";
}

<h1 class="h3 mb-3">New sport</h1>

<form asp-action="Create" method="post" class="col-lg-6">
    <partial name="_SportFormPartial" model="@Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
