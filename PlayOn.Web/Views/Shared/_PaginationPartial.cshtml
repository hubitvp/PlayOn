@model PaginationViewModel
@{
    var totalPages = Model?.TotalPages ?? 0;
    var currentPage = Model?.Page ?? 1;

    var numbers = new List<int?>();
    for (var n = 1; n <= totalPages; n++)
    {
        if (n == 1 || n == totalPages || Math.Abs(n - currentPage) <= 2)
        {
            numbers.Add(n);
        }
        else if (numbers[^1] is not null)
        {
            numbers.Add(null);
        }
    }
    var hasPrevious = currentPage > 1;
    var hasNext = currentPage < totalPages;
}
@if (totalPages > 1 && Model?.PageUrl != null)
{
    <nav aria-label="Pages">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(hasPrevious ? "" : "disabled")">
                <a class="page-link" href="@(hasPrevious ? Model.PageUrl(currentPage - 1) : "#")" aria-label="Previous page">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @foreach (var number in numbers)
            {
                if (number is null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else if (number == currentPage)
                {
                    <li class="page-item active" aria-current="page"><span class="page-link">@number</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@Model.PageUrl(number.Value)">@number</a></li>
                }
            }

            <li class="page-item @(hasNext ? "" : "disabled")">
                <a class="page-link" href="@(hasNext ? Model.PageUrl(currentPage + 1) : "#")" aria-label="Next page">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}