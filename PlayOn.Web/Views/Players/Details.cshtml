@model PlayerProfileViewModel
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-1">@Model.DisplayName</h1>
                <p class="text-muted"><i class="bi bi-geo-alt"></i> @Model.City</p>

                <dl class="row mb-3">
                    <dt class="col-7">Matches played</dt>
                    <dd class="col-5">@Model.MatchesPlayed</dd>
                    <dt class="col-7">Reliability</dt>
                    <dd class="col-5">
                        @if (Model.Reliability is int reliability)
                        {
                            <span>@reliability%</span>
                        }
                        else
                        {
                            <span class="text-muted">Not enough matches</span>
                        }
                    </dd>
                    <dt class="col-7">No-shows</dt>
                    <dd class="col-5">@Model.NoShowCount</dd>
                    <dt class="col-7">Late cancellations</dt>
                    <dd class="col-5">@Model.LateCancelCount</dd>
                    <dt class="col-7">Rating</dt>
                    <dd class="col-5">
                        @if (Model.AverageRating is { } average)
                        {
                            <span><i class="bi bi-star-fill text-warning"></i> @average</span>
                            <small class="text-muted">(@Model.RatingCount)</small>
                        }
                        else
                        {
                            <span class="text-muted">No ratings yet</span>
                        }
                    </dd>
                </dl>

                @if (Model.IsOwnProfile)
                {
                    <a asp-action="Edit" class="btn btn-outline-primary btn-sm">Edit my profile</a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <h2 class="h5">Skill levels</h2>
        @if (Model.Skills == null || Model.Skills.Count == 0)
        {
            <p class="text-muted">No skill levels set yet.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var skill in Model.Skills)
                {
                    <span class="sport-chip">
                        <i class="@skill.SportIcon" aria-hidden="true"></i> @skill.SportName
                        <partial name="_SkillBadgePartial" model="(SkillLevel?)skill.SkillLevel" />
                    </span>
                }
            </div>
        }

        <h2 class="h5">What teammates say</h2>
        @if (Model.RecentRatings == null || Model.RecentRatings.Count == 0)
        {
            <p class="text-muted">No comments yet.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var rating in Model.RecentRatings)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@rating.RaterName</strong>
                            <span><i class="bi bi-star-fill text-warning"></i> @rating.Score</span>
                        </div>
                        <p class="mb-1">@rating.Comment</p>
                        <small class="text-muted">@rating.MatchTitle</small>
                    </li>
                }
            </ul>
        }
    </div>
</div>