
@model MatchInputModelBase

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" maxlength="80" placeholder="Thursday 5-a-side" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"
              placeholder="Bring both light and dark shirts. Meet at the main entrance."></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="DurationMinutes" class="form-label"></label>
        <input asp-for="DurationMinutes" type="number" class="form-control" min="30" max="180" step="15" data-role="duration" />
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        <div class="form-text" data-role="slot-hint"></div>
    </div>
    <div class="col-md-4">
        <label asp-for="MinPlayers" class="form-label"></label>
        <input asp-for="MinPlayers" type="number" class="form-control" min="2" max="60" />
        <span asp-validation-for="MinPlayers" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxPlayers" class="form-label"></label>
        <input asp-for="MaxPlayers" type="number" class="form-control" min="2" max="60" data-role="max-players" />
        <span asp-validation-for="MaxPlayers" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="MinSkill" class="form-label"></label>
        <select asp-for="MinSkill" asp-items="Html.GetEnumSelectList<SkillLevel>()" class="form-select"></select>
        <span asp-validation-for="MinSkill" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxSkill" class="form-label"></label>
        <select asp-for="MaxSkill" asp-items="Html.GetEnumSelectList<SkillLevel>()" class="form-select"></select>
        <span asp-validation-for="MaxSkill" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PricePerPlayer" class="form-label"></label>
        <input asp-for="PricePerPlayer" type="number" class="form-control" min="0" max="500" step="0.5" />
        <span asp-validation-for="PricePerPlayer" class="text-danger"></span>
    </div>
</div>
