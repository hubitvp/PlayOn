@model MatchDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var percent = Model.MaxPlayers == 0 ? 0 : Model.Joined * 100 / Model.MaxPlayers;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="sport-chip"><i class="@Model.SportIcon" aria-hidden="true"></i> @Model.SportName</span>
            <partial name="_StatusBadgePartial" model="Model.Status" />
        </div>

        <h1 class="h3">@Model.Title</h1>

        @if (Model.IsHidden)
        {
            <div class="alert alert-warning">This match is hidden from other players.</div>
        }

        @if (Model.Status == MatchStatus.Cancelled)
        {
            <div class="alert alert-danger">
                <strong>This match was cancelled.</strong>
                @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
                {
                    <div>@Model.CancelReason</div>
                }
            </div>
        }

        <p class="text-muted">
            <i class="bi bi-calendar-event"></i> @Model.StartsAt - @Model.EndsAt (@Model.DurationMinutes min)<br />
            <i class="bi bi-geo-alt"></i> @Model.VenueName, @Model.Address, @Model.City<br />
            <i class="bi bi-grid-3x3"></i> @Model.CourtName, @Model.Surface
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p style="white-space: pre-line">@Model.Description</p>
        }

        <dl class="row">
            <dt class="col-sm-4">Skill level</dt>
            <dd class="col-sm-8">
                <partial name="_SkillBadgePartial" model="(SkillLevel?)Model.MinSkill" />
                @if (Model.MaxSkill != Model.MinSkill)
                {
                    <span class="text-muted">to</span>
                    <partial name="_SkillBadgePartial" model="(SkillLevel?)Model.MaxSkill" />
                }
            </dd>
            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">@(Model.PricePerPlayer == "0.00" ? "Free" : $"{Model.PricePerPlayer} EUR per player")</dd>
            <dt class="col-sm-4">Organiser</dt>
            <dd class="col-sm-8">
                @Model.OrganiserName
                @if (Model.OrganiserReliability is int reliability)
                {
                    <span class="text-muted small">(@reliability% reliable)</span>
                }
            </dd>
        </dl>

        @if (Model.CanManage)
        {
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
                <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger">Cancel match</a>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Players</h2>
                <div class="progress mb-1" style="height: 8px" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(Model.Joined >= Model.MaxPlayers ? "bg-warning" : "bg-success")" style="width: @percent%"></div>
                </div>
                <p class="small text-muted">
                    @Model.Joined / @Model.MaxPlayers joined, at least @Model.MinPlayers needed
                    @if (Model.Waitlisted > 0)
                    {
                        <text>(+@Model.Waitlisted waiting)</text>
                    }
                </p>
                <partial name="_RosterPartial" model="Model.Participants" />
            </div>
        </div>
    </div>
</div>

<p class="mt-4"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> All matches</a></p>
