@model VenueViewModel
@{
    ViewData["Title"] = "Venues";
}

<h1 class="h3 mb-1">Venues</h1>
<p class="text-muted">Every venue listing is one slot: a place, a date and a start time for a single match.</p>

@if (Model.Venues == null || Model.Venues.Count == 0)
{
    <div class="alert alert-info">No venue slots available right now.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var venue in Model.Venues)
        {
            <div class="col">
                <partial name="_VenueCardPartial" model="@venue" />
            </div>
        }
    </div>

    var pagination = new PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageUrl = p => Url.Action("Index", "Venues", new { page = p }, null, null, null)!
    };

    <div class="mt-4">
        <partial name="_PaginationPartial" model="@pagination" />
    </div>
}