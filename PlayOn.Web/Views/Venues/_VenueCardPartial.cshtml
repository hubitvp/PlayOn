@model VenueViewModelData

@{
    var venue = Model;
}

<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h2 class="h5 card-title">@venue.Name</h2>
        <p class="text-muted mb-2">
            <i class="bi bi-geo-alt"></i> @venue.Address, @venue.City<br />
            <i class="bi bi-calendar-event"></i> @venue.Date, starts @venue.StartsAt<br />
            <i class="bi bi-clock"></i> Open @venue.OpensAt - @venue.ClosesAt
        </p>
        @if (venue.Court is { } court)
        {
            <h3 class="h6 text-uppercase text-muted">Court</h3>
            <div class="d-flex justify-content-between border-top py-1">
                <span>
                    <i class="@court.SportIconCss"></i>
                    @court.Name
                    <span class="text-muted small">(@court.Surface, up to @court.Capacity)</span>
                </span>
                <span class="small">@court.HourlyPrice EUR/h</span>
            </div>
        }
    </div>
    <div class="card-footer bg-transparent">
        @if (venue.MatchId is { } matchId)
        {
            <a asp-controller="Matches" asp-action="Details" asp-route-id="@matchId" asp-route-slug="@venue.Slug">
                <i class="bi bi-trophy"></i> @venue.MatchTitle
            </a>
        }
        else
        {
            <span class="badge text-bg-success me-2">Free slot</span>
            <a asp-controller="Matches" asp-action="Create" asp-route-venueId="@venue.Id">Organise a match here</a>
        }
    </div>
</div>