@model HomeViewModel
@{
    ViewData["Title"] = "Find a game";
}

@section Hero {
    <section class="hero text-white py-5">
        <div class="container">
            <h1 class="display-5 fw-bold">Find a game tonight.</h1>
            <p class="lead">Join matches near you, fill your roster, and play with people you can rely on.</p>

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get"
                  class="row g-2 hero-search">
                <div asp-validation-summary="ModelOnly" class="fs-4 text-warning"></div>
                <div class="col-md-4">
                    <select asp-for="SportId"
                            name="sport"
                            asp-items="@Model.SportOptions"
                            class="form-select form-select-lg">
                        <option value="">Any sport</option>
                    </select>
                    <span asp-validation-for="SportId" class="fs-4 text-warning"></span>
                </div>

                <div class="col-md-3">
                    <input asp-for="City"
                           name="city"
                           class="form-control form-control-lg"
                           placeholder="City" />
                    <span asp-validation-for="City" class="fs-4 text-warning"></span>
                </div>

                <div class="col-md-3">
                    <div class="input-group input-group-lg">
                        <input asp-for="From"
                               name="from"
                               type="date"
                               placeholder="dd/mm/yyyy"
                               class="form-control form-control-lg"
                               data-date-picker data-date-picker-button="#fromToggle" />
                        <button type="button" id="fromToggle" class="btn btn-light d-none" title="Pick a date" aria-label="Pick a date">
                            <i class="bi bi-calendar-event"></i>
                        </button>
                    </div>
                    <span asp-validation-for="From" class="fs-4 text-warning"></span>
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-light btn-lg" type="submit">
                        Search
                    </button>
                </div>
            </form>
        </div>
    </section>
}

@if (Model.Page == null || Model.Page.PageItems.Count == 0)
{
    <div class="alert alert-info">
        No upcoming matches
    </div>
}
else
{
    var first = (Model.Page.PageMark - 1) * Model.Page.PageSize + 1;
    var last = first + Model.Page.PageItems.Count - 1;

    <div id="matches" class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Upcoming matches</h2>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small">Showing @first&ndash;@last of @Model.Page.TotalItemsCount</span>
            <a asp-controller="Matches" asp-action="Index" class="small text-decoration-none">All matches &rarr;</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var match in Model.Page.PageItems)
        {
            <div class="col"><partial name="_HomeMatchCardPartial" model="match" /></div>
        }
    </div>

    var pagination = new PaginationViewModel
    {
        Page = Model.Page.PageMark,
        TotalPages = Model.Page.TotalPages,
        PageUrl = page => Url.Action("Index", "Home", new
        {
            page,
            sport = Model.SportId,
            city = Model.City,
            from = Model.From
        }, null, null, "matches")!
    };

    <div class="mt-4">
        <partial name="_PaginationPartial" model="@pagination" />
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/lib/flatpickr/dist/flatpickr.min.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/flatpickr/dist/flatpickr.min.js" asp-append-version="true"></script>
}