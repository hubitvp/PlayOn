@model ErrorPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header border-0 bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-camera-video me-2"></i>PlayOn VAR booth</span>
                <span class="badge rounded-pill text-bg-danger">LIVE REVIEW</span>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="row align-items-center g-4">
                    <div class="col-md-5 text-center">
                        <div class="display-1 fw-bold text-danger">@Model.Code</div>
                        <div class="text-uppercase small fw-bold text-muted letter-spacing-1">Unexpected technical foul</div>
                        <div class="mt-3 fs-1" aria-hidden="true">🟥</div>
                    </div>
                    <div class="col-md-7">
                        <h1 class="h2 mb-3">@Model.Title</h1>
                        <p class="lead text-muted">@Model.Message</p>
                        <div class="alert alert-warning border-0 mb-4">
                            <i class="bi bi-hourglass-split me-2"></i>
                            The officials are reviewing the play. Please try again shortly.
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" onclick="window.location.reload()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Replay the play
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-house-door me-1"></i>Leave the stadium
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
