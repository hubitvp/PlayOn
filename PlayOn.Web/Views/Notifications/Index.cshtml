@model NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notifications</h1>
    @if (Model.UnreadCount > 0)
    {
        <form asp-action="ReadAll" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                Mark all as read (@Model.UnreadCount)
            </button>
        </form>
    }
</div>

@if (!Model.Notifications.Any())
{
    <p class="text-muted">You have no notifications yet.</p>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var notification in Model.Notifications)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start gap-3 @(notification.IsRead ? "" : "list-group-item-light fw-semibold")">
                <div>
                    <i class="@notification.IconCss me-1" aria-hidden="true"></i>
                    @notification.Message
                    <div class="small text-muted fw-normal">@notification.CreatedOn</div>
                </div>
                <form asp-action="Read" asp-route-id="@notification.Id" method="post">
                    <button type="submit" class="btn btn-sm @(notification.IsRead ? "btn-outline-secondary" : "btn-outline-primary")">
                        @(notification.MatchId.HasValue ? "Open" : "OK")
                    </button>
                </form>
            </div>
        }
    </div>

    var pagination = new PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageUrl = p => Url.Action("Index", "Notifications", new { page = p })!
    };

    <div class="mt-4">
        <partial name="_PaginationPartial" model="@pagination" />
    </div>
}
